# PinBoard Environment Configuration
# Copy this file to .env.local and fill in your values
# 
# ⚠️  NEVER commit your actual .env.local file — it is ignored by git
# 
# Get your OpenRouter API key (free tier available):
# https://openrouter.ai/keys

# ===========================================
# AI Configuration (OpenRouter)
# ===========================================

# Optional reference only — the app does NOT read this env var.
# Model selection is client-side: Settings → Vision Model (localStorage).
# Hardcoded default free VL: nvidia/nemotron-nano-12b-v2-vl:free
# (see lib/ai.ts DEFAULT_AI_MODEL and lib/types.ts DEFAULT_SETTINGS)
#
# OPENROUTER_API_KEY is also not read by the app today; paste your key in Settings.
# Listed here for documentation / future server-side use.
# OPENROUTER_API_KEY=sk-or-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ===========================================
# Optional Settings
# ===========================================

# App name (used in metadata)
NEXT_PUBLIC_APP_NAME=PinBoard

# Base URL (useful for deployment)
# NEXT_PUBLIC_BASE_URL=https://your-domain.com
